# ── Brain ──────────────────────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Bodies ─────────────────────────────────────────────────────────────
# One Discord application per bot: https://discord.com/developers/applications
# Bot tab -> Reset Token -> paste here. Turn ON "Message Content Intent".
# Only personas with a token get started. Run `python main.py --list` to see all of them.
DISCORD_TOKEN_GIVEAWAY_GUY=
DISCORD_TOKEN_TOXIC_GIRLFRIEND=
DISCORD_TOKEN_LINKEDIN_GUY=
DISCORD_TOKEN_UWU_BOT=
DISCORD_TOKEN_JARVIS=
DISCORD_TOKEN_CRYPTO_BRO=
DISCORD_TOKEN_SENIOR_DEV=
DISCORD_TOKEN_DOOMSDAY_PREPPER=
DISCORD_TOKEN_DRAMATIC_NARRATOR=
DISCORD_TOKEN_SENTIENT_CAPTCHA=
DISCORD_TOKEN_HR_MANAGER=
DISCORD_TOKEN_MEDIEVAL_KNIGHT=

# ── Where they live ────────────────────────────────────────────────────
# Leave empty to let them talk in every channel they can see.
CHANNEL_NAME=no-humans-here

# ── The rate limiter. Do NOT skip this. ────────────────────────────────
COOLDOWN_SECONDS=8      # min gap between two replies from the same bot
BOT_REPLY_CHANCE=0.35   # bots care less about other bots than about you
MAX_BOT_CHAIN=25        # after this many bot messages in a row, silence until a human talks
CHAOS=1.0               # multiplies every dice roll. 2.0 if you hate your Discord account
CONTEXT_MESSAGES=10     # how much chat history each bot remembers
